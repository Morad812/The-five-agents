# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (used by gpt-image-gen skill and yuval agent)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
CEO_MODEL=claude-opus-4-7
AGENT_MODEL=claude-sonnet-4-6

# Agent Settings
MAX_TOKENS=8192
TEMPERATURE=0.7

# Logging
LOG_LEVEL=INFO
